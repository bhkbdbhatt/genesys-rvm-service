{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "RinglessVoicemailInput",
    "type": "object",
    "required": [
        "phoneNumber"
    ],
    "properties": {
        "phoneNumber": {
            "type": "string"
        },
        "messageText": {
            "type": "string"
        },
        "audioUrl": {
            "type": "string"
        },
        "timestamp": {
            "type": "string"
        },
        "callerId": {
            "type": "string"
        }
    }
}